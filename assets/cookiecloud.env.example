# CookieCloud 是推荐的登录态来源。
# Docker 服务端默认部署在运行本技能的本机时，使用 127.0.0.1 即可。
# 如果 CookieCloud 服务端在另一台机器，请改成 http://<服务器IP>:8088。
COOKIECLOUD_SERVER_URL=http://127.0.0.1:8088
COOKIECLOUD_UUID=<setup.py --init 会自动生成>
COOKIECLOUD_PASSWORD=<setup.py --init 会自动生成>

# 兼容旧脚本变量名，保持与上面相同。
COOKIECLOUDUUID=<同 COOKIECLOUD_UUID>
COOKIECLOUDPASSWORD=<同 COOKIECLOUD_PASSWORD>

# 可选：原始 Cookie 兜底。不推荐发布或写入日志。
# XIAOHONGSHU_COOKIE=
# ZHIHU_COOKIE=
# ZHIHU_COOKIES=
